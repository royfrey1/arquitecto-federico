# URL pública del sitio, sin barra final. Se usa para metadataBase (URLs absolutas de
# canonical, Open Graph, JSON-LD, sitemap y robots).
# Si no se define, se usa https://arquitecto-federico.vercel.app
# En Vercel: Project Settings → Environment Variables → NEXT_PUBLIC_SITE_URL (Production).
NEXT_PUBLIC_SITE_URL=https://arquitecto-federico.vercel.app
